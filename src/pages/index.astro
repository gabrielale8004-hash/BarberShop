---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- ============================================
        NAVBAR — Glassmorphism
        ============================================ -->
  <header class="site-header" id="navbar">
    <nav class="container nav-inner" aria-label="Navegación principal">
      <a class="brand" href="#inicio" aria-label="BarberShop, inicio">
        <div class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="14" y="4" width="4" height="24" rx="2" />
            <path d="M12 10h8M12 16h8M12 22h8" stroke="#EF4444" stroke-width="2" />
            <path d="M12 14h8" stroke="#FFFFFF" stroke-width="2" />
            <path d="M12 18h8" stroke="#1E3A8A" stroke-width="2" />
            <path d="M8 8L14 14M24 8L18 14" stroke="#B45309" stroke-width="2" />
          </svg>
        </div>
        <span class="brand-name">BarberShop</span>
        <span class="brand-tag">Barbería Premium</span>
      </a>

      <div class="nav-links">
        <a class="nav-link" href="#inicio">Inicio</a>
        <a class="nav-link" href="#servicios">Servicios</a>
        <a class="nav-link" href="#galeria">Galería</a>
        <a class="nav-link" href="#nosotros">Nosotros</a>
        <a class="nav-link" href="#contacto">Contacto</a>
      </div>

      <a class="button button-primary nav-booking" href="#contacto">
        <span>Reservar Ahora</span>
      </a>
    </nav>
  </header>

  <!-- ============================================
        HERO — Con OBJETO 3D REAL CENTRADO
        ============================================ -->
  <section class="hero" id="inicio">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-overlay"></div>
    </div>

    <div class="container hero-grid">
      <div class="hero-copy relative-container">
        
        <!-- ============================================
              VISOR 3D REAL (model-viewer)
              Posicionado en el centro detrás del texto
              ============================================ -->
        <div class="shaver-3d-bg" aria-hidden="true">
          <!-- Importamos el script del visor 3D oficial de Google -->
          <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
          
          <model-viewer
            src="https://modelviewer.dev/shared-assets/models/Astronaut.glb" 
            alt="Objeto 3D con volumen y profundidad real"
            auto-rotate
            rotation-per-second="25deg"
            disable-zoom
            disable-pan
            no-controls
            interaction-prompt="none"
            camera-controls="false"
            shadow-intensity="2"
            exposure="1.2"
            class="real-3d-model"
          >
          </model-viewer>
        </div>

        <!-- Contenido de texto principal -->
        <h1 class="hero-title">
          El arte de la <br />
          <span class="text-gradient">barbería masculina</span>
        </h1>

        <p class="hero-description">
          Cortes clásicos, afeitados con navaja y estilo moderno.
          Una experiencia premium diseñada para el hombre que cuida cada detalle.
        </p>

        <div class="hero-actions">
          <a class="button button-primary button-cta" href="#contacto">
            <span class="cta-label">Reservar Ahora</span>
            <span class="cta-icon">📅</span>
          </a>
          <a class="button button-ghost" href="#servicios">
            Ver Servicios
          </a>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">15+</span>
            <span class="stat-label">Años de experiencia</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">500+</span>
            <span class="stat-label">Clientes satisfechos</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">5★</span>
            <span class="stat-label">Calificación promedio</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="image-frame-3d">
          <img
            class="hero-image"
            src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1200&q=85"
            alt="Barbero profesional trabajando en corte clásico"
          />
        </div>
        <div class="hero-floating-card">
          <div class="floating-icon">✂</div>
          <div class="floating-content">
            <span class="floating-tag">Corte Clásico</span>
            <span class="floating-price">$25.000</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
        SERVICIOS
        ============================================ -->
  <section class="section" id="servicios">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">Nuestros Servicios</div>
        <h2 class="section-title">Cortes y tratamientos <span class="text-gradient">excepcionales</span></h2>
        <p class="section-description">
          Cada servicio está diseñado para resaltar tu estilo personal con
          precisión quirúrgica y atención al detalle.
        </p>
      </div>

      <div class="service-grid">
        <!-- Servicio 1 -->
        <article class="service-card">
          <div class="service-image-wrap">
            <img
              class="service-image"
              src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=800&q=80"
              alt="Corte clásico con perfilado"
            />
            <div class="service-image-gradient"></div>
            <div class="service-card-overlay">
              <span class="service-number">01</span>
              <h3 class="service-title">Corte Clásico</h3>
              <p class="service-description">Corte tradicional con máquina y tijera, acabado impecable y estilo atemporal.</p>
              <div class="service-meta">
                <span>30 min</span>
                <span>Desde $15.000</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Servicio 2 -->
        <article class="service-card">
          <div class="service-image-wrap">
            <img
              class="service-image"
              src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=800&q=80"
              alt="Afeitado con navaja"
            />
            <div class="service-image-gradient"></div>
            <div class="service-card-overlay">
              <span class="service-number">02</span>
              <h3 class="service-title">Afeitado con Navaja</h3>
              <p class="service-description">Afeitado tradicional con navaja de afeitar, toallas calientes y bálsamo post-afeitado.</p>
              <div class="service-meta">
                <span>45 min</span>
                <span>Desde $20.000</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Servicio 3 -->
        <article class="service-card">
          <div class="service-image-wrap">
            <img
              class="service-image"
              src="https://images.unsplash.com/photo-1517832606299-7ae9b720a186?auto=format&fit=crop&w=800&q=80"
              alt="Barba y perfilado"
            />
            <div class="service-image-gradient"></div>
            <div class="service-card-overlay">
              <span class="service-number">03</span>
              <h3 class="service-title">Barba y Perfilado</h3>
              <p class="service-description">Diseño y perfilado de barba con maquinilla, navaja y productos especializados.</p>
              <div class="service-meta">
                <span>40 min</span>
                <span>Desde $18.000</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Servicio 4 -->
        <article class="service-card">
          <div class="service-image-wrap">
            <img
              class="service-image"
              src="https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&w=800&q=80"
              alt="Corte moderno"
            />
            <div class="service-image-gradient"></div>
            <div class="service-card-overlay">
              <span class="service-number">04</span>
              <h3 class="service-title">Corte Moderno</h3>
              <p class="service-description">Estilos actuales, fades, degradados y cortes adaptados a tu fisionomía.</p>
              <div class="service-meta">
                <span>35 min</span>
                <span>Desde $17.000</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Servicio 5 -->
        <article class="service-card">
          <div class="service-image-wrap">
            <img
              class="service-image"
              src="https://images.unsplash.com/photo-1599351431202-1e0f0137899a?auto=format&fit=crop&w=800&q=80"
              alt="Cejas y rostro"
            />
            <div class="service-image-gradient"></div>
            <div class="service-card-overlay">
              <span class="service-number">05</span>
              <h3 class="service-title">Cejas y Rostro</h3>
              <p class="service-description">Diseño de cejas, limpieza facial y cuidado de la piel para hombres.</p>
              <div class="service-meta">
                <span>25 min</span>
                <span>Desde $10.000</span>
              </div>
            </div>
          </div>
        </article>

        <!-- Servicio 6 -->
        <article class="service-card">
          <div class="service-image-wrap">
            <img
              class="service-image"
              src="https://images.unsplash.com/photo-1585747860715-2ba37e788b70?auto=format&fit=crop&w=800&q=80"
              alt="Paquete Premium"
            />
            <div class="service-image-gradient"></div>
            <div class="service-card-overlay">
              <span class="service-number">06</span>
              <h3 class="service-title">Paquete Premium</h3>
              <p class="service-description">Corte, afeitado, barba, cejas y masaje facial. La experiencia completa.</p>
              <div class="service-meta">
                <span>90 min</span>
                <span>Desde $45.000</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================
        GALERÍA
        ============================================ -->
  <section class="section gallery-section" id="galeria">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">Galería</div>
        <h2 class="section-title">Estilos y cortes <span class="text-gradient">destacados</span></h2>
        <p class="section-description">Descubre nuestros trabajos más recientes.</p>
      </div>

      <div class="gallery-grid">
        <article class="gallery-item">
          <div class="gallery-frame">
            <img src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=800&q=80" alt="Corte Clásico" />
            <div class="gallery-overlay">
              <div class="gallery-info">
                <h3>Corte Clásico</h3>
                <p>Perfilado con navaja</p>
              </div>
            </div>
          </div>
        </article>

        <article class="gallery-item">
          <div class="gallery-frame">
            <img src="https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&w=800&q=80" alt="Fade Moderno" />
            <div class="gallery-overlay">
              <div class="gallery-info">
                <h3>Fade Moderno</h3>
                <p>Degradado piel</p>
              </div>
            </div>
          </div>
        </article>

        <article class="gallery-item">
          <div class="gallery-frame">
            <img src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=800&q=80" alt="Barba Completa" />
            <div class="gallery-overlay">
              <div class="gallery-info">
                <h3>Barba Completa</h3>
                <p>Perfilado preciso</p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================
        NOSOTROS
        ============================================ -->
  <section class="section experience-section" id="nosotros">
    <div class="container experience-grid">
      <div class="experience-copy">
        <div class="section-badge">Nuestra Historia</div>
        <h2 class="section-title">Más que un <span class="text-gradient">corte, una experiencia</span></h2>
        <p class="experience-description">
          En BarberShop combinamos la tradición de la barbería clásica con las técnicas más modernas. Cada detalle cuenta: desde la toalla caliente hasta el último toque de estilo.
        </p>
        <ul class="experience-features">
          <li class="feature-item">
            <span style="color:var(--color-gold); font-weight:bold;">✓</span>
            <span>Herramientas de alta precisión</span>
          </li>
          <li class="feature-item">
            <span style="color:var(--color-gold); font-weight:bold;">✓</span>
            <span>Barberos certificados</span>
          </li>
          <li class="feature-item">
            <span style="color:var(--color-gold); font-weight:bold;">✓</span>
            <span>Ambiente premium y relajado</span>
          </li>
        </ul>
      </div>

      <div class="experience-visual">
        <div class="experience-image-wrapper">
          <img src="https://images.unsplash.com/photo-1585747860715-2ba37e788b70?auto=format&fit=crop&w=1000&q=85" alt="Interior de barbería premium" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
        CTA CONTACTO
        ============================================ -->
  <section class="cta-section" id="contacto">
    <div class="container cta-content">
      <div class="cta-badge">Reserva tu cita</div>
      <h2 class="cta-title">¿Listo para tu <span class="text-gradient">nuevo estilo</span>?</h2>
      <p class="cta-description">Reserva tu cita hoy y recibe un 10% de descuento en tu primer corte.</p>
      <a class="button button-primary button-cta button-large" href="https://wa.me/" target="_blank" rel="noopener">
        <span class="cta-label">Reservar por WhatsApp</span>
        <span class="cta-icon">📱</span>
      </a>
      <div class="cta-trust">
        <span class="trust-item">✓ Pagos con tarjeta</span>
        <span class="trust-item">✓ Confirmación inmediata</span>
        <span class="trust-item">✓ Cancelación gratuita</span>
      </div>
    </div>
  </section>

  <!-- ============================================
        FOOTER
        ============================================ -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="footer-brand-name">BarberShop</span>
      </div>
      <p class="footer-copy">© 2026 BarberShop — Barbería Premium. Todos los derechos reservados.</p>
    </div>
  </footer>
</Layout>