
---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <header class="site-header">
    <nav class="container nav-inner" aria-label="Navegación principal">
      <a class="brand" href="#inicio" aria-label="BarberShop, inicio">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" width="31" height="31" fill="none">
            <circle cx="20" cy="20" r="17" stroke="currentColor" />
            <path
              d="M13 11h14M13 16h14M13 21h14M13 26h14M16 11v18M24 11v18"
              stroke="currentColor"
              stroke-width="1"
            />
          </svg>
        </span>

        <span>
          <span class="brand-name">BarberShop</span>
          <span class="brand-caption">El arte del buen corte</span>
        </span>
      </a>

      <div class="nav-links">
        <a class="nav-link" href="#inicio">Inicio</a>
        <a class="nav-link" href="#servicios">Servicios</a>
        <a class="nav-link" href="#nosotros">Nosotros</a>
        <a class="nav-link" href="#galeria">Galería</a>
        <a class="nav-link" href="#contacto">Contacto</a>
      </div>

      <a class="button button-outline nav-booking" href="#contacto">
        Reservar cita
      </a>
    </nav>
  </header>

  <main>
    <section class="hero" id="inicio">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Barbería clásica premium</p>

          <h1 class="hero-title">
            El estilo se define en los <em>detalles.</em>
          </h1>

          <p class="hero-description">
            Un espacio dedicado al arte de la barbería, donde la tradición,
            la precisión y el estilo se encuentran.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#servicios">
              Descubrir servicios
            </a>

            <a class="text-link" href="#nosotros">
              Conócenos <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="hero-values" aria-label="Nuestros valores">
            <div class="hero-value">
              <strong>01</strong>
              <span>Precisión</span>
            </div>

            <div class="hero-value">
              <strong>02</strong>
              <span>Tradición</span>
            </div>

            <div class="hero-value">
              <strong>03</strong>
              <span>Estilo</span>
            </div>
          </div>
        </div>

        <div class="hero-visual" id="galeria">
          <img
            class="hero-image"
            src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1400&q=85"
            alt="Interior de una barbería con ambiente clásico"
            width="1400"
            height="1700"
            fetchpriority="high"
          />
          <div class="image-frame" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="experience-strip" id="nosotros">
      <div class="container experience-inner">
        <h2 class="experience-title">
          Más que un corte, una experiencia.
        </h2>

        <a class="text-link" href="#servicios">
          Conoce nuestros servicios <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="section" id="servicios">
      <div class="container services-layout">
        <div class="section-heading">
          <p class="eyebrow">Nuestro trabajo</p>

          <h2 class="section-title">Servicios con carácter.</h2>

          <p class="section-description">
            Cada detalle importa. Descubre una atención pensada para resaltar
            tu estilo personal y ofrecerte un acabado impecable.
          </p>
        </div>

        <div class="service-grid">
          <article class="service-card">
            <svg
              class="service-icon"
              viewBox="0 0 40 40"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <circle cx="10" cy="29" r="5" />
              <circle cx="30" cy="29" r="5" />
              <path d="M13 25 29 5l4 3-16 20M27 25 11 5 7 8l16 20" />
            </svg>

            <span class="service-number">01</span>
            <h3 class="service-title">Corte clásico</h3>
            <p class="service-description">
              Cortes definidos y personalizados, con atención a cada detalle.
            </p>
          </article>

          <article class="service-card">
            <svg
              class="service-icon"
              viewBox="0 0 40 40"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <path d="m7 29 19-23a4 4 0 0 1 6 6L13 35l-6-6Z" />
              <path d="m23 10 7 6M10 26l5 5M27 8l5 5" />
            </svg>

            <span class="service-number">02</span>
            <h3 class="service-title">Corte moderno</h3>
            <p class="service-description">
              Estilos actuales adaptados a tus facciones y preferencias.
            </p>
          </article>

          <article class="service-card">
            <svg
              class="service-icon"
              viewBox="0 0 40 40"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <path
                d="M5 15c5 0 5-5 10-5 3 0 3 4 5 4s2-4 5-4c5 0 5 5 10 5l-3 12c-2 5-7 8-12 8s-10-3-12-8L5 15Z"
              />
              <path d="M10 19c3 4 6 5 10 5s7-1 10-5M14 29h12" />
            </svg>

            <span class="service-number">03</span>
            <h3 class="service-title">Barba y perfilado</h3>
            <p class="service-description">
              Definición y cuidado para conseguir un acabado limpio y preciso.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="closing-section">
      <div class="container">
        <p class="eyebrow" style="justify-content: center">
          Tu próximo estilo comienza aquí
        </p>

        <h2 class="closing-title">
          Los buenos detalles nunca pasan de moda.
        </h2>

        <a class="button button-primary" href="#contacto">
          Hablemos de tu próximo corte
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer" id="contacto">
    <div class="container footer-inner">
      <a class="brand" href="#inicio">
        <span class="brand-name">BarberShop</span>
      </a>

      <p class="footer-copy">
        El arte del buen corte. Atención al detalle.
      </p>

      <a class="text-link" href="#inicio">
        Volver arriba <span aria-hidden="true">↑</span>
      </a>
    </div>
  </footer>
</Layout>
